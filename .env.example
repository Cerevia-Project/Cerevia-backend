# API
PORT=3001

# FalkorDB (graph + vector)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# PostgreSQL (system of record: identity, RBAC, workflow, audit)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=cerevia
POSTGRES_PASSWORD=cerevia
POSTGRES_DB=cerevia
# Set to true for providers that require TLS (e.g. Neon)
POSTGRES_SSL=false

# Redis (BullMQ queue — a separate instance from FalkorDB).
# Use REDIS_HOST/REDIS_PORT for a plain instance, or REDIS_URL (e.g. Upstash
# "rediss://…") to override both.
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=

# Object storage: "fs" (filesystem, default for dev) or "s3" (S3-compatible).
# With "fs", uploads are written to .data/uploads/ (no external service needed).
STORAGE_BACKEND=fs

# S3 backend settings (only used when STORAGE_BACKEND=s3)
S3_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_BUCKET=cerevia-uploads
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_FORCE_PATH_STYLE=true

# LLM & embeddings
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-large
VOYAGE_EMBEDDING_DIMENSION=1024

# Misc
NODE_ENV=development

# Cross-origin frontend (set to the frontend's origin, e.g. http://localhost:5173)
FRONTEND_ORIGIN=

# Auto-run migrations + bootstrap on boot (defaults on in production)
AUTO_MIGRATE=false

# Bootstrap (first-run seed)
BOOTSTRAP_ADMIN_EMAIL=admin@cerevia.dev
BOOTSTRAP_ADMIN_PASSWORD=admin12345
BOOTSTRAP_ORG_NAME=Cerevia
