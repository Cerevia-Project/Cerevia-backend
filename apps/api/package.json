{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node scripts/copy-migrations.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "migrate": "tsx scripts/migrate.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "eval": "tsx scripts/eval.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.15",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "falkordb": "^6.8.0",
    "file-type": "^22.2.0",
    "ioredis": "^6.0.0",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "unpdf": "^1.9.0",
    "voyageai": "^0.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
